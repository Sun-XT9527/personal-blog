---
import '../styles/global.css';
import {snapshot,pathTo} from '../lib/snapshot';
const {title=snapshot.settings.name,description=snapshot.settings.description}=Astro.props;
const nav=[['文章','posts/'],['分类','categories/'],['作品','projects/'],['关于','about/'],['留言','guestbook/']];
---
<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><meta name="description" content={description}><meta name="theme-color" content="#f8f5ef"><title>{title===snapshot.settings.name?title:`${title} · ${snapshot.settings.name}`}</title><link rel="icon" type="image/svg+xml" href={pathTo('favicon.svg')}><meta property="og:title" content={title}><meta property="og:description" content={description}><meta property="og:type" content="website"></head><body><a class="skip-link" href="#main">跳到主要内容</a><header class="site-header"><div class="header-inner"><a class="brand" href={pathTo()} aria-label="博客首页"><span class="brand-icon">S<span>·</span></span><span>{snapshot.settings.name}</span></a><nav aria-label="主导航">{nav.map(([name,path])=><a href={pathTo(path)} aria-current={Astro.url.pathname.includes(`/${path}`)?'page':undefined}>{name}</a>)}</nav><a class="search-link" href={pathTo('posts/#search')} aria-label="搜索文章">⌕</a></div></header><main id="main"><slot /></main><footer class="site-footer"><div><a class="footer-brand" href={pathTo()}>{snapshot.settings.name}</a><p>写下来，让日常有迹可循。</p></div><div class="footer-links"><a href={snapshot.settings.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a><a href={pathTo('write/')}>管理后台</a><span>© {new Date().getFullYear()} {snapshot.settings.author}</span><span class="preview-label">开发预览</span></div></footer></body></html>
