---
import Layout from '../../layouts/Layout.astro';import Messages from '../../components/Messages';import {posts,pathTo,dateText} from '../../lib/snapshot';import {headings,renderHighlightedDocument} from '../../lib/document';
export function getStaticPaths(){return posts.map(post=>({params:{slug:post.slug},props:{post}}));}const {post}=Astro.props;const index=posts.findIndex(p=>p.id===post.id);const newer=posts[index-1],older=posts[index+1];const outline=headings(post.document);const html=await renderHighlightedDocument(post.document);
---
<Layout title={post.title} description={post.excerpt}><div class="container page-heading article-layout"><article><header class="article-header"><a class="text-link" href={pathTo('posts/')}>← 回到所有文章</a><div class="post-meta" style="margin-top:30px"><a href={pathTo(`posts/?category=${encodeURIComponent(post.category)}`)}>{post.category}</a><time datetime={post.published_at}>{dateText(post.published_at)}</time></div><h1>{post.title}</h1>{post.cover&&<img src={post.cover} alt="文章封面"/>}</header>{outline.length>0&&<details class="mobile-toc"><summary>文章目录</summary><ol>{outline.map(item=><li><a href={`#${item.id}`}>{item.text}</a></li>)}</ol></details>}<div class="prose" set:html={html}></div><nav class="article-neighbors" aria-label="上一篇和下一篇"><div>{newer&&<><span>较新的记录</span><a href={pathTo(`posts/${newer.slug}/`)}>← {newer.title}</a></>}</div><div>{older&&<><span>较早的记录</span><a href={pathTo(`posts/${older.slug}/`)}>{older.title} →</a></>}</div></nav><Messages postId={post.id} client:load /></article>{outline.length>0&&<aside class="article-aside"><strong>文章目录</strong><ol>{outline.map(item=><li style={item.level>2?'margin-left:12px':undefined}><a href={`#${item.id}`}>{item.text}</a></li>)}</ol></aside>}</div><div class="section-bottom" style="min-height:20px;padding-bottom:40px"></div></Layout>
