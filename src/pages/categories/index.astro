---
import Layout from '../../layouts/Layout.astro';import {posts,pathTo} from '../../lib/snapshot';import {categories} from '../../lib/defaults';

---
<Layout title="分类"><section class="container page-heading"><span class="eyebrow">FIND YOUR THREAD</span><h1>沿着兴趣，往下读<span class="heading-dot">.</span></h1><p>从一个主题开始，发现更多记录。</p></section><section class="container section-bottom"><div class="category-grid">{categories.map((name,i)=><a href={pathTo(`categories/${encodeURIComponent(name)}/`)} class="category-card"><span class="category-num">0{i+1}</span><h2>{name} ↗</h2><p>{posts.filter(p=>p.category===name).length} 篇记录</p></a>)}</div></section></Layout>
