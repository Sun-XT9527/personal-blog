---
import {pathTo} from '../../lib/snapshot';
import {categories,isCategory,legacyCategories} from '../../lib/categories';
export function getStaticPaths(){return [...categories,...legacyCategories].map(name=>({params:{name}}));}
const {name}=Astro.params;
return Astro.redirect(pathTo(isCategory(name)?`posts/?category=${encodeURIComponent(name)}`:'posts/'),301);
---
