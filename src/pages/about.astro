---
import Layout from '../layouts/Layout.astro';import {aboutCopy} from '../lib/about-copy';import {snapshot,pathTo} from '../lib/snapshot';import {renderDocument,safeUrl} from '../lib/document';import {socialPlatforms} from '../lib/socials';
const links=[{label:'GitHub',url:snapshot.settings.github},...socialPlatforms.map(({key,label})=>({label,url:snapshot.settings.socials[key]}))].filter(link=>safeUrl(link.url));
---
<Layout title="关于我"><section class="container page-heading"><span class="eyebrow">{aboutCopy.eyebrow}</span><h1>你好，我是 {snapshot.settings.author}<span class="heading-dot">.</span></h1><p>{aboutCopy.introduction}</p></section><section class="container about-layout section-bottom"><aside class="profile-card"><div class="avatar-letter">S<span>✳</span></div><h2>{snapshot.settings.author}</h2><p>{aboutCopy.tagline}</p><nav class="profile-links" aria-label="我的其他主页">{links.map(link=><a class="text-link" href={safeUrl(link.url)} target="_blank" rel="noopener noreferrer">在 {link.label} 找到我 <span aria-hidden="true">↗</span></a>)}</nav></aside><div><div class="prose" set:html={renderDocument(snapshot.settings.about)}></div><div class="about-note"><h3>{aboutCopy.reasonTitle}</h3><p>{aboutCopy.reason}</p><a class="text-link" href={pathTo('guestbook/')}>{aboutCopy.invitation}</a></div></div></section></Layout>
